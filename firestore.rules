rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /medicines/{documentId} {
      allow read, write: if request.auth != null;
    }

    match /lab_tests/{documentId} {
      allow read, write: if request.auth != null;
    }

    match /lab_bundles/{documentId} {
      allow read, write: if request.auth != null;
    }

    match /articles/{documentId} {
      allow read, write: if request.auth != null;
    }

    match /symptoms/{documentId} {
      allow read, write: if request.auth != null;
    }

    match /questions/{documentId} {
      allow read, write: if request.auth != null;
    }

    match /conditions/{documentId} {
      allow read, write: if request.auth != null;
    }

    match /meta/{documentId} {
      allow read, write: if request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }
  }
}
